APP_NAME="FastAPI Videogames API"
APP_VERSION="0.1.0"
# development | production (production enforces strong JWT and warns on SQLite)
ENVIRONMENT="development"

DATABASE_URL="sqlite+aiosqlite:///./app.db"
DB_ECHO=false

# Connection pool (used when DATABASE_URL is not SQLite)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=28000
# DB_POOL_PRE_PING=true

# Min 32 characters when ENVIRONMENT=production. Do not use defaults in prod.
JWT_SECRET_KEY="replace-with-a-long-random-secret-at-least-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated browser origins for CORS (leave empty to disable CORS middleware).
# Never use "*" with credentials: this app uses allow_credentials=True and requires explicit origins.
# CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Host header allowlist for TrustedHostMiddleware (include testserver for TestClient; adjust behind reverse proxy)
# ALLOWED_HOSTS="localhost,127.0.0.1,testserver"

# API version prefix for mounted routers (auth, videogames)
# API_V1_PREFIX="/api/v1"

# OpenAPI/docs: omit or set ENABLE_OPENAPI=true|false. Default is off in production, on in development.
# ENABLE_OPENAPI=true

# Strict-Transport-Security (only if all responses are HTTPS end-to-end)
# SECURITY_ENABLE_HSTS=false
# SECURITY_HSTS_MAX_AGE=15552000

# Browser refresh: httpOnly cookie + JSON csrf_token; native clients can keep AUTH_REFRESH_COOKIE_ENABLED=false and use body refresh only
# AUTH_REFRESH_COOKIE_ENABLED=false
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=lax

# SlowAPI limits (per client IP) for public auth endpoints
# AUTH_REGISTER_RATE_LIMIT="10/minute"
# AUTH_LOGIN_RATE_LIMIT="30/minute"
# AUTH_REFRESH_RATE_LIMIT="60/minute"
# AUTH_VERIFY_EMAIL_RATE_LIMIT="30/minute"
# AUTH_FORGOT_PASSWORD_RATE_LIMIT="10/minute"
# AUTH_RESET_PASSWORD_RATE_LIMIT="20/minute"

# Email verification (optional; when true, login requires POST /auth/verify-email first)
# AUTH_REQUIRE_EMAIL_VERIFICATION=false
# EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=4320
# PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# EMAIL_BACKEND=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="noreply@localhost"
# SMTP_USE_TLS=true

# Postgres example (Docker / prod): install asyncpg, then e.g.
# DATABASE_URL="postgresql+asyncpg://user:pass@localhost:5432/videogames"
